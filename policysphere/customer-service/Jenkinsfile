pipeline {
  agent any
  tools { jdk 'jdk21'; maven 'maven3' }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build & Test') {
      steps { dir('policysphere/customer-service') { sh 'mvn clean verify' } }
    }
    stage('Docker Build') {
      steps {
        dir('policysphere/customer-service') {
          sh 'docker build -t policysphere/customer-service:${BUILD_NUMBER} -t policysphere/customer-service:latest .'
        }
      }
    }
  }
}